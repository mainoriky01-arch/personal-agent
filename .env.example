# Copy this file to .env and adjust as needed.

# Port the backend HTTP server listens on (default 8788).
PORT=8788

# Durable storage. When set, the backend runs in durable mode and persists data
# in this file-backed PGlite directory; unset → in-memory mode (state is lost on
# restart). Durable mode lands with COD-2.
PA_DB_PATH=

# Shared bearer token (COD-16). When set, every route except GET /health requires
# the header `Authorization: Bearer <PA_AUTH_TOKEN>`; requests without it get 401.
# Leave unset (or empty) to keep the backend open — the dev/test default and what
# the current client expects. Never commit a real value.
PA_AUTH_TOKEN=

# Per-request logging (COD-18). On by default: one structured line per HTTP
# request (method/path/status/durationMs) to stdout. Set PA_LOG=off to silence it.
PA_LOG=

# APNs push delivery (COD-10). Set ALL of APNS_KEY_ID / APNS_TEAM_ID /
# APNS_BUNDLE_ID / APNS_DEVICE_TOKEN / APNS_PRIVATE_KEY to deliver real pushes via
# Apple (token-based, HTTP/2); leave any unset to keep the in-memory stub (the
# dev/test default). Never commit real values — this file only documents them.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_DEVICE_TOKEN=
# The .p8 EC private key contents (PEM). Single-line env: replace real newlines
# with literal \n; the backend restores them.
APNS_PRIVATE_KEY=
# Optional: override the APNs host (default https://api.push.apple.com; use
# https://api.sandbox.push.apple.com for the sandbox).
APNS_HOST=

# LLM features (COD-14 intent extraction for POST /chat/draft, COD-15 intervention
# copy). Set ANTHROPIC_API_KEY to use the real Anthropic Messages API for BOTH; the
# copy draft still passes the Safety Layer before delivery. Leave it unset to keep
# the keyword stub + deterministic templates (the dev/test default — no network).
# Never commit a real key.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-sonnet-5 — a cost-appropriate tier
# for this lightweight extraction task) and API base URL.
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=
